{
  "manifest_version": 3,
  "name": "Tabscape",
  "description": "A new tab that feels like home: your favourite sites, a friendly hello, and a night sky that moves.",
  "version": "0.0.0",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ]
}
